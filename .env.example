# Application
APP_NAME=Helix Migration
APP_ENV=development
APP_SECRET_KEY=change_me

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
DATABASE_URL=postgresql://helix:helix_password@postgres:5432/helix_metadata

# Redis
REDIS_URL=redis://redis:6379/0

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Security
JWT_SECRET_KEY=change_me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=change_me_32_byte_key

# LLM Defaults
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1

# Optional Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Artifact Storage (MVP — local filesystem)
ARTIFACT_STORAGE_PROVIDER=local
ARTIFACT_STORAGE_PATH=./data/artifacts
MAX_UPLOAD_MB=25

# Safe Execution
SAFE_EXECUTION_MODE=analysis_only

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Helix Migration
SMTP_USE_TLS=true
SMTP_USE_STARTTLS=true
