# ─────────────────────────────────────────────────────────────────
# Helix Migration — sample environment.
#
# Quick start:
#   cp .env.example .env
#   ./scripts/generate-secrets.sh        (or .\scripts\generate-secrets.ps1 on Windows)
#   docker compose up -d
#
# DO NOT commit a populated .env file. .gitignore covers .env / .env.*
# ─────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────────
APP_NAME="Helix Migration"
APP_ENV=production
# Demo mode (optional). When both are true, the login page shows a
# "Login with Demo User" button that signs into a read-only, pre-seeded demo
# organization (no credentials). Backend gate + frontend build-time flag.
# Leave false in production unless you want a public demo sandbox.
# Seed the demo content once: docker exec helix-worker python -m app.cli.seed_demo_migration <demo_org_id>
ALLOW_DEMO_LOGIN=false
NEXT_PUBLIC_DEMO_ENABLED=false
# REQUIRED. Generated by scripts/generate-secrets.sh — do not ship a default.
APP_SECRET_KEY=

# ── Database (Postgres) ─────────────────────────────────────────────
POSTGRES_USER=helix
POSTGRES_DB=helix_metadata
# REQUIRED. Generated by scripts/generate-secrets.sh.
POSTGRES_PASSWORD=
# Internal Docker hostname is `postgres`. Override only if running Postgres outside compose.
DATABASE_URL=
# Optional read replica. When set, hot-path read endpoints (dashboard rollup,
# project list, audit-log pagination) route to this replica; writes always
# go to DATABASE_URL.
DATABASE_READ_URL=

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Temporal ────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=helix-bmad-task-queue
# Required when using the temporal-ui debug profile.
# Set TEMPORAL_AUTH_ENABLED=true and provide a strong password.
# Leaving auth disabled on a reachable UI is a security risk (DC-021).
TEMPORAL_AUTH_ENABLED=true
TEMPORAL_UI_USERNAME=
TEMPORAL_UI_PASSWORD=
# Temporal debug UI (only with `docker compose --profile debug up`). Keep bound
# to loopback. Setting TEMPORAL_UI_BIND off-loopback REQUIRES
# TEMPORAL_AUTH_ENABLED=true + a strong TEMPORAL_UI_PASSWORD (SC-034).
TEMPORAL_UI_BIND=127.0.0.1
TEMPORAL_UI_HOST_PORT=8233

# ── Security ────────────────────────────────────────────────────────
# REQUIRED. Generated by scripts/generate-secrets.sh.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# REQUIRED. 32-byte Fernet key. Generated by scripts/generate-secrets.sh.
ENCRYPTION_KEY=
# REQUIRED. HMAC key for audit chain integrity. MUST differ from JWT_SECRET_KEY
# so JWT rotation does not invalidate the audit chain. Generated by scripts/generate-secrets.sh.
AUDIT_HMAC_KEY=
# Bootstrap token required to create the first super-admin via
# POST /api/v1/auth/first-admin (SC-011). Set a random hex value before
# exposing the backend; the wizard/CLI must send it as the X-Setup-Token header.
SETUP_TOKEN=
# Optional static bearer for the backend /metrics route (SC-056). When set,
# scrapers must send `Authorization: Bearer <token>`. Empty = no extra gate.
METRICS_TOKEN=

# ── CORS ────────────────────────────────────────────────────────────
# Production: set to your frontend's origin(s). Comma-separated JSON array.
# Example: ["https://helix.example.com"]
CORS_ORIGINS=["http://localhost:3000"]
# Optional regex for dynamic origins (e.g. preview deploys). Leave empty in prod.
CORS_ORIGIN_REGEX=

# ── Reverse Proxy / TLS (Caddy) ─────────────────────────────────────
# Required for TLS (Caddy auto-LetsEncrypt). Must be a fully-qualified domain
# name pointing at this VM's external IP before starting the caddy service.
# Example: HELIX_PUBLIC_DOMAIN=helix.example.com
HELIX_PUBLIC_DOMAIN=

# Comma-separated trusted reverse-proxy IPs (or `*` to trust exactly one hop).
# Empty = never trust X-Forwarded-For (affects audit-log client IP + the rate
# limiter, SC-051). Set to your Caddy/LB IP(s) when running behind a proxy.
TRUSTED_PROXIES=

# Interface the published ports bind to. Loopback by default (safe behind Caddy).
# Set to 0.0.0.0 only for local dev / direct access without a reverse proxy.
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1
# Host-side published ports. Change to avoid collisions or run multiple stacks
# (mainly relevant for direct, non-Caddy access).
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# ── Frontend ────────────────────────────────────────────────────────
# What the BROWSER uses to reach the API. EMPTY = same-origin: the browser calls
# /api/* relative and it is proxied to the backend (by the Next.js rewrite for a
# plain stack, or by Caddy for a TLS domain). This is the recommended default —
# it works in any browser and is required for the HttpOnly SameSite session
# cookie over http. Set an absolute URL (e.g. https://helix.example.com) ONLY
# for a split-host / cross-origin deploy.
# NOTE: baked into the frontend image at build time — rebuild after changing.
NEXT_PUBLIC_API_URL=
# In-network URL the Next.js SERVER forwards /api/* to (the same-origin proxy
# target). Default is the compose service name; override only if the backend
# runs elsewhere or the service is renamed.
BACKEND_PROXY_URL=http://helix-backend:8000

# ── Image source ────────────────────────────────────────────────────
# Local builds use helix/<svc>:latest. To pull pre-built images instead, set
# HELIX_IMAGE_PREFIX=ghcr.io/your-org (and a tag), then `docker compose pull`.
HELIX_IMAGE_PREFIX=helix
HELIX_IMAGE_TAG=latest

# ── Dev overlay only (docker-compose.dev.yml) ───────────────────────
# Loopback-bound host ports for the dev overlay; remap to avoid clashes.
FRONTEND_DEV_HOST_PORT=8080
POSTGRES_DEV_HOST_PORT=5432
REDIS_DEV_HOST_PORT=6379
TEMPORAL_DEV_HOST_PORT=7233

# ── LLM Defaults ────────────────────────────────────────────────────
# Operators configure providers + API keys via the admin UI after first launch.
# These defaults only seed the dropdown — they are not used at runtime.
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1

# Optional bootstrap keys (skip if configuring via UI):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ── Artifact Storage ────────────────────────────────────────────────
# `local` writes to the helix_artifacts Docker volume. For multi-host deploys
# set ARTIFACT_STORAGE_PROVIDER=s3 and configure the S3_* env vars below.
ARTIFACT_STORAGE_PROVIDER=local
ARTIFACT_STORAGE_PATH=/app/data/artifacts
MAX_UPLOAD_MB=25

# ── S3 / S3-compatible artifact storage (when ARTIFACT_STORAGE_PROVIDER=s3) ──
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=helix-artifacts
# Optional — set when using MinIO, Cloudflare R2, Backblaze B2 etc.
S3_ENDPOINT_URL=
# Auth comes from the standard boto3 chain — AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in env, ~/.aws/credentials, or IAM instance role.

# ── Safe Execution ──────────────────────────────────────────────────
SAFE_EXECUTION_MODE=analysis_only

# ── Optional SMTP (invitations + password reset emails) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Helix Migration"
# Use STARTTLS (port 587). Read by config as SMTP_USE_TLS / SMTP_TLS.
SMTP_USE_TLS=true

# ── Optional observability ──────────────────────────────────────────
SENTRY_DSN=
OTEL_ENDPOINT=

# ── Frontend URL used in invitation emails ──────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Slack integration (optional — slash-command approvals) ──────────
# When set, POST /api/v1/integrations/slack/command verifies inbound
# slash commands with HMAC-SHA256 and forwards approve/reject to the
# matching Temporal workflow. Leave blank to disable the receiver.
SLACK_SIGNING_SECRET=
# Either point HELIX_SLACK_USER_MAP at a JSON file mapping
# {slack_user_id: helix_user_id} OR set a single fallback user via
# HELIX_SLACK_DEFAULT_USER.
HELIX_SLACK_USER_MAP=
HELIX_SLACK_DEFAULT_USER=

# ── Optional LLM cost rate overrides ────────────────────────────────
# JSON map of "{provider}:{model}" → [input_usd_per_1m, output_usd_per_1m].
# Default rates (2026-05) ship in app/services/cost_service.py — override
# here if you have negotiated different pricing with your vendor.
HELIX_PROVIDER_RATES_JSON=
