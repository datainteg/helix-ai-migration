# ─────────────────────────────────────────────────────────────────
# Helix Migration — sample environment.
#
# Quick start:
#   cp .env.example .env
#   ./scripts/generate-secrets.sh        (or .\scripts\generate-secrets.ps1 on Windows)
#   docker compose up -d
#
# DO NOT commit a populated .env file. .gitignore covers .env / .env.*
# ─────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────────
APP_NAME=Helix Migration
APP_ENV=production
# REQUIRED. Generated by scripts/generate-secrets.sh — do not ship a default.
APP_SECRET_KEY=

# ── Database (Postgres) ─────────────────────────────────────────────
POSTGRES_USER=helix
POSTGRES_DB=helix_metadata
# REQUIRED. Generated by scripts/generate-secrets.sh.
POSTGRES_PASSWORD=
# Internal Docker hostname is `postgres`. Override only if running Postgres outside compose.
DATABASE_URL=

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Temporal ────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=helix-bmad-task-queue
# Optional: protect Temporal UI with basic auth. Generated by secrets script.
# If empty, Temporal UI is open to anyone with network access to port 8233.
TEMPORAL_UI_USERNAME=admin
TEMPORAL_UI_PASSWORD=

# ── Security ────────────────────────────────────────────────────────
# REQUIRED. Generated by scripts/generate-secrets.sh.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# REQUIRED. 32-byte Fernet key. Generated by scripts/generate-secrets.sh.
ENCRYPTION_KEY=
# REQUIRED. HMAC key for audit chain integrity. MUST differ from JWT_SECRET_KEY
# so JWT rotation does not invalidate the audit chain. Generated by scripts/generate-secrets.sh.
AUDIT_HMAC_KEY=

# ── CORS ────────────────────────────────────────────────────────────
# Production: set to your frontend's origin(s). Comma-separated JSON array.
# Example: ["https://helix.example.com"]
CORS_ORIGINS=["http://localhost:3000"]
# Optional regex for dynamic origins (e.g. preview deploys). Leave empty in prod.
CORS_ORIGIN_REGEX=

# ── Frontend ────────────────────────────────────────────────────────
# What the browser uses to call the API. Baked into the frontend at build time.
# When running compose locally: http://localhost:8000
# When deploying behind a reverse proxy: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── LLM Defaults ────────────────────────────────────────────────────
# Operators configure providers + API keys via the admin UI after first launch.
# These defaults only seed the dropdown — they are not used at runtime.
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1

# Optional bootstrap keys (skip if configuring via UI):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ── Artifact Storage ────────────────────────────────────────────────
# `local` writes to the helix_artifacts Docker volume. For multi-host deploys
# set ARTIFACT_STORAGE_PROVIDER=s3 and configure AWS_* env vars.
ARTIFACT_STORAGE_PROVIDER=local
ARTIFACT_STORAGE_PATH=/app/data/artifacts
MAX_UPLOAD_MB=25

# ── Safe Execution ──────────────────────────────────────────────────
SAFE_EXECUTION_MODE=analysis_only

# ── Optional SMTP (invitations + password reset emails) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Helix Migration
SMTP_USE_TLS=true
SMTP_USE_STARTTLS=true

# ── Optional observability ──────────────────────────────────────────
SENTRY_DSN=
OTEL_ENDPOINT=

# ── Frontend URL used in invitation emails ──────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Slack integration (optional — slash-command approvals) ──────────
# When set, POST /api/v1/integrations/slack/command verifies inbound
# slash commands with HMAC-SHA256 and forwards approve/reject to the
# matching Temporal workflow. Leave blank to disable the receiver.
SLACK_SIGNING_SECRET=
# Either point HELIX_SLACK_USER_MAP at a JSON file mapping
# {slack_user_id: helix_user_id} OR set a single fallback user via
# HELIX_SLACK_DEFAULT_USER.
HELIX_SLACK_USER_MAP=
HELIX_SLACK_DEFAULT_USER=

# ── Optional LLM cost rate overrides ────────────────────────────────
# JSON map of "{provider}:{model}" → [input_usd_per_1m, output_usd_per_1m].
# Default rates (2026-05) ship in app/services/cost_service.py — override
# here if you have negotiated different pricing with your vendor.
HELIX_PROVIDER_RATES_JSON=
