# Force LF on all shell scripts and POSIX text so Windows clones with
# core.autocrlf=true don't break execution on Linux / WSL2 / GCE VMs.
# Cross-ref: docs/review-v4/DEPLOY_SETUP.md DSETUP-005 (CRLF hazard).

# Shell + bash
*.sh        text eol=lf
*.bash      text eol=lf
setup.sh    text eol=lf

# Container + compose
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.dockerfile    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Env templates (read by Python config; must be LF or python-dotenv chokes)
.env.example    text eol=lf
.env.*.example  text eol=lf

# PowerShell stays CRLF for Windows-native consumers
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# Binary blobs — never normalise
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
